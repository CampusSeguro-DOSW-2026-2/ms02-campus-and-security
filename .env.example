# Copiar a .env. La app lo lee al correr local (mvnw spring-boot:run) y Docker Compose al levantar los contenedores.
DB_HOST=localhost
# Puerto de la base publicado en el equipo (docker-compose lo expone en este puerto)
DB_PORT=5433
DB_NAME=campus
DB_USER=campus_user
DB_PASSWORD=cambia_esto
APP_PORT=8080
