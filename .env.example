# Copiar a .env. La app lo lee al correr local (mvnw spring-boot:run) y Docker Compose al levantar los contenedores.
DB_HOST=localhost
# Puerto de la base publicado en el equipo (docker-compose lo expone en este puerto)
DB_PORT=5433
DB_NAME=campus
DB_USER=campus_user
DB_PASSWORD=cambia_esto
APP_PORT=8082

# --- Integración con el API Gateway (docker-compose.gw.yml) ---
# Prefijos de MS02 que el GW enruta (todo lo que no esté aquí responde 404).
SQUAD_PATHS=/api/v1/buildings,/api/v1/buildings/**,/api/v1/floors/**,/api/v1/spaces/**,/api/v1/safe-zones,/api/v1/safe-zones/**,/api/v1/evacuation-routes,/api/v1/evacuation-routes/**,/api/v1/preventive-recommendations,/api/v1/preventive-recommendations/**
# Solo si MS02 llama a otro MS. Generar con: openssl rand -base64 48
SQUAD_SERVICE_KEY=
# Llaves JWT: mejor exportarlas en la terminal (ver la guía del GW) y dejarlas vacías aquí.
JWT_PUBLIC_KEY=
JWT_PRIVATE_KEY=
MS01_DB_PASSWORD=cambiar-por-una-clave-local
# Primer ADMIN (opcional), para probar las rutas de administración.
BOOTSTRAP_ADMIN_EMAIL=
BOOTSTRAP_ADMIN_PASSWORD=
BOOTSTRAP_ADMIN_FIRST_NAME=
BOOTSTRAP_ADMIN_LAST_NAME=
